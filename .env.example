# =============================================================================
# Enterprise Voice-First AI Command Center — Environment Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------

# Option A: Groq (fast inference, free tier)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama3-70b-8192

# Option B: Google Gemini (OpenAI-compatible API)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=AIza_your_gemini_key_here
# LLM_MODEL=gemini-2.0-flash

# Option C: Azure OpenAI
# LLM_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT
# LLM_API_KEY=your_azure_openai_key
# LLM_MODEL=gpt-4o
# LLM_API_VERSION=2024-02-01

# Option D: Local Ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:70b

# LLM generation settings
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------

# Local Redis (default — installed via winget)
REDIS_URL=redis://localhost:6379/0

# Azure Cache for Redis (production)
# REDIS_URL=rediss://:YOUR_ACCESS_KEY@YOUR_CACHE_NAME.redis.cache.windows.net:6380/0

REDIS_SESSION_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Speech Processing — STT (faster-whisper)
# -----------------------------------------------------------------------------

# Model size: tiny | base | small | medium | large-v3
# Use "base" for development, "medium" or "large-v3" for production
STT_MODEL_SIZE=base

# Model download directory (relative to backend/)
STT_MODEL_DIR=.models/whisper

# Language constraints (comma-separated ISO 639-1 codes, or "auto")
STT_LANGUAGES=en,hi,ta,te,kn,mr,bn

# Compute type: float32 | float16 | int8 (int8 is fastest on CPU)
STT_COMPUTE_TYPE=int8

# Device: cpu | cuda (use cpu for Azure Virtual Desktop without GPU)
STT_DEVICE=cpu

# -----------------------------------------------------------------------------
# Speech Processing — TTS
# -----------------------------------------------------------------------------

# Provider: kokoro | edge_tts
TTS_PROVIDER=kokoro

# Kokoro model directory (relative to backend/)
TTS_KOKORO_MODEL_DIR=.models/kokoro

# Default voice ID (Kokoro voices: af_heart, af_bella, am_adam, etc.)
TTS_DEFAULT_VOICE=af_heart

# edge-tts voice (used when TTS_PROVIDER=edge_tts or as fallback)
TTS_EDGE_VOICE=en-IN-NeerjaNeural

# TTS output format: wav | pcm
TTS_OUTPUT_FORMAT=wav

# -----------------------------------------------------------------------------
# RAG / Vector Store Configuration
# -----------------------------------------------------------------------------

# Vector store backend: faiss | pgvector
VECTOR_STORE=faiss

# Embedding model: local (sentence-transformers) or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# For production pgvector (set VECTOR_STORE=pgvector):
# POSTGRES_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Number of chunks to retrieve per RAG query
RAG_TOP_K=5

# FAISS index persistence directory (relative to backend/)
FAISS_INDEX_DIR=faiss_indices

# -----------------------------------------------------------------------------
# Observability — Langfuse (OPTIONAL)
# -----------------------------------------------------------------------------
# Leave empty or unset to disable Langfuse tracing entirely.

# Langfuse Cloud
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# Self-hosted Langfuse
# LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
# LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: json | console (use console for development, json for production)
LOG_FORMAT=console

# Backend server settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend settings
FRONTEND_PORT=5173

# Set to false to disable frontend static file serving (API-only mode)
FRONTEND_ENABLED=true

# CORS origins (comma-separated; * for development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Session configuration
MAX_TURNS_BEFORE_ESCALATION=10
PLANNER_MAX_LOOP_COUNT=3

# Domain plugin directory (relative to backend/app/)
DOMAINS_DIR=domains

# -----------------------------------------------------------------------------
# Security (Production Only)
# -----------------------------------------------------------------------------

# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Required in production. Leave empty for development (insecure default used).
# SESSION_SECRET_KEY=your-64-char-hex-secret-here
